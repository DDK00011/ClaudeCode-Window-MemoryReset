# ── Personal data / runtime state (never commit) ──
# git does not support inline comments(`pattern   # comment`) → comments must be on separate lines.

# Recovery history (all CSV files including recovery-history.csv)
*.csv
# All backup/rollover variants (including recovery-history.csv.bak)
recovery-history.*
# User threshold/polling settings
tray-settings.json
# Runtime state including last alert time
tray-state.json
# Tracking/alert settings + Telegram bot token (secret — never commit)
tracker-settings.json
# Process CPU activity snapshot (runtime state)
activity-state.json
# Last alert time/cooldown (runtime state)
tracker-state.json
# All logs including tray / tracker daemon debug logs
*.log

# Backups
*.txt.bak
*.json.bak

# Local config / secrets
.env
.env.local
.env.*
secrets/
*.pfx
*.key
*.pem
credentials*

# Windows artifacts
Thumbs.db
desktop.ini
*.lnk

# PowerShell artifacts
*.ps1.bak
PSScriptAnalyzerResults.txt

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store

# Test outputs
test-output/
*.tmp

# ── macOS port (macos/) ──
macos/tracker-settings.json
macos/menubar-settings.json
macos/activity-state.tsv
macos/tracker-state.tsv
macos/recovery-history.csv
macos/*.log
macos/.menubar.lock
macos/MemoryResetMenuBar.app/
